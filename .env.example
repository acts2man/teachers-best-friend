OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for the workspace RPCs (get_workspace_json, sync_workspace).
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated site origins allowed to POST, e.g.
# https://ateachersbestfriend.com,https://www.ateachersbestfriend.com
# Set in Netlify (Functions + Runtime scope). Outside production the request's
# own forwarded host is also accepted (deploy previews, branch deploys, dev).
ALLOWED_ORIGINS=
# The host(s) the app is allowed to serve from in production. Comma-separated;
# the FIRST is canonical (the redirect target and the address error messages
# name). Usually one entry, e.g. teachersbestfriend.netlify.app. During a domain
# switchover, list both with the new domain first, e.g.
#   ateachersbestfriend.com,teachersbestfriend.netlify.app
# Each entry is forgiving of a scheme, trailing slash, port, or case
# (lib/canonical-host.ts normalizeHost), so a mis-entered value can't self-outage.
# The host guard refuses any production request whose host is not in this list,
# which is what stops a Netlify deploy permalink from being a usable copy of the
# app carrying the production service key.
#   * Set it at BUILD scope in Netlify (it is inlined at build, like CONTEXT),
#     so both the server guard and the browser redirect read the same value.
#   * Only the "production" deploy context enforces it. Deploy previews, branch
#     deploys and localhost stand down, so leaving this unset locally is fine.
#   * If it is UNSET in production the app fails loud (refuses) rather than
#     silently allowing every host -- a loud outage is fixed in minutes; a
#     silent allow-everything is how a permalink runs unnoticed for nine days.
CANONICAL_HOST=
