OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for the workspace RPCs (get_workspace_json, sync_workspace).
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated site origins allowed to POST, e.g.
# https://ateachersbestfriend.com,https://www.ateachersbestfriend.com
# Set in Netlify (Functions + Runtime scope). The forwarded host is also accepted.
ALLOWED_ORIGINS=
